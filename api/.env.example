# Copy this file to .env (ignored by git) and fill in the values. Never commit real credentials.

# Render dashboard > pollution-db > Connect > "External Database URL"
# (the internal URL only works from services running on Render)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.oregon-postgres.render.com/DATABASE

# Optional: force SSL on (true) or off (false). By default it is deduced from the host:
# on for a remote host (Render external URL), off for localhost and Render's internal URL.
# DB_SSL=true

# Optional: port of the API (3000 by default)
# PORT=3000

# Optional: print every SQL query sent by Sequelize (debugging)
# DB_LOGGING=true
